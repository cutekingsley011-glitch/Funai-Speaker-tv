# FUNAI SPEAKER TV - Environment Configuration

# Newsroom Admin Password
# Set your desired private newsroom password here or in your Vercel / hosting environment variables.
# The backend checks FSTV_ADMIN_PASSWORD or ADMIN_PASSWORD.
# If neither is set, it defaults to Speaker6969
FSTV_ADMIN_PASSWORD=Speaker6969
ADMIN_PASSWORD=Speaker6969

# Base URL of the website (used for WhatsApp & social link previews)
APP_URL=https://funaispeakertv.com
VITE_APP_URL=https://funaispeakertv.com

# Server configuration
PORT=3000
NODE_ENV=development

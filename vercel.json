{
  "buildCommand": "vite build && esbuild api/index.ts --bundle --platform=node --format=esm --target=node18 --outfile=api/index.js",
  "outputDirectory": "dist",
  "functions": {
    "api/**": {
      "includeFiles": "{dist/**,index.html,data-backup.json,public/**}"
    }
  },
  "rewrites": [
    {
      "source": "/story-image/(.*)",
      "destination": "/api?__path=story-image/$1"
    },
    {
      "source": "/story/(.*)",
      "destination": "/api?__path=story/$1"
    },
    {
      "source": "/(.*)",
      "has": [
        {
          "type": "query",
          "key": "story"
        }
      ],
      "destination": "/api"
    },
    {
      "source": "/(.*)",
      "has": [
        {
          "type": "query",
          "key": "id"
        }
      ],
      "destination": "/api"
    },
    {
      "source": "/(.*)",
      "has": [
        {
          "type": "header",
          "key": "user-agent",
          "value": "(?i).*(facebookexternalhit|whatsapp|twitterbot|telegrambot|linkedinbot|discordbot|slackbot).*"
        }
      ],
      "destination": "/api"
    },
    {
      "source": "/api/(.*)",
      "destination": "/api?__path=$1"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
